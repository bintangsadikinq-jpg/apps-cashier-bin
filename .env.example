# Kosongkan untuk pakai SQLite lokal (data/kasir.db).
# Isi dengan database Turso (SQLite terkelola) supaya data permanen di Vercel.
TURSO_DATABASE_URL=libsql://nama-db-anda.turso.io
TURSO_AUTH_TOKEN=

# Password untuk membuka Riwayat (wajib diisi, tanpa ini Riwayat terkunci selamanya).
APP_PASSWORD=
# Kunci tanda tangan cookie login. Isi string acak panjang (opsional, tapi disarankan).
SESSION_SECRET=
